NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Use * to allow all origins, or a comma-separated list of origins.
CORS_ORIGIN=*

# MongoDB Atlas — fill in real credentials before starting the server.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food_database?retryWrites=true&w=majority
# Name of the existing product collection inside the above database.
MONGODB_COLLECTION=products

# Cache collection for scanned & AI-extracted products (never writes to MONGODB_COLLECTION)
SCAN_CACHE_COLLECTION=scan_cache

# Gemini API configuration for multimodal ingredient/nutrition extraction
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
